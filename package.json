{
  "name": "hellfall-pixel-siege",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación web FPS pixelada con usuarios, roles, puntuaciones y arquitectura por capas (Hitos 1-3).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --check src/server.js && node --check public/js/game/game.js && vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
