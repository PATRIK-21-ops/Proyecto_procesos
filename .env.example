# Configuración general
NODE_ENV=development
PORT=8080
SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
DATABASE_URL=
PGSSL=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_POR_UNA_SEGURA
LOG_LEVEL=info
MAX_SCORE_KILLS=100
ALLOWED_DOMAINS=uclm.es,alu.uclm.es,gmail.com

# --- CONFIGURACIÓN DE BREVO (SMTP o API) ---
REQUIRE_EMAIL_CONFIRMATION=true
APP_BASE_URL=http://localhost:8080

# Opción A: Usando SMTP de Brevo (compatible con tu Nodemailer actual)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp_de_brevo@smtp-brevo.com
SMTP_PASS=tu_contraseña_smtp_o_api_key_de_brevo
SMTP_FROM=tucorreo@tudominio.com