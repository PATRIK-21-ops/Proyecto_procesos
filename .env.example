# Copia este archivo a .env y rellena los valores para tu entorno local.
NODE_ENV=development
PORT=8080
# URL pública de la aplicación. En Render debe coincidir con la URL del servicio.
APP_URL=http://localhost:8080
SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
DATABASE_URL=
# Para PostgreSQL gestionado suele ser necesario SSL. Valores: require o disable.
PGSSL=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_POR_UNA_SEGURA
LOG_LEVEL=info
# Límites del servidor de puntuaciones de demostración
MAX_SCORE_KILLS=100
ALLOWED_DOMAINS = uclm.es,alu.uclm.es

# --- Confirmación de correo ---
# Si se activa, los registros quedan pendientes hasta pulsar el enlace del correo.
REQUIRE_EMAIL_CONFIRMATION=true
# Servidor SMTP para el envío de correos (por ejemplo Gmail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
