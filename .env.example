# Copia este archivo a .env y rellena los valores para tu entorno local.
NODE_ENV=development
PORT=8080
SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
DATABASE_URL=
# Para PostgreSQL gestionado suele ser necesario SSL. Valores: require o disable.
PGSSL=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_POR_UNA_SEGURA
LOG_LEVEL=info
# Límites del servidor de puntuaciones de demostración
MAX_SCORE_KILLS=100
ALLOWED_DOMAINS = uclm.es,alu.uclm.es
