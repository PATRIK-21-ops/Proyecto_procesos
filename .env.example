# ============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO - HELLFALL v4.0 (DOOM 1993 EDITION)
# Copia este archivo como '.env' en la raíz de tu proyecto y ajusta los valores.
# ============================================================================

# Entorno de ejecución ('development' o 'production')
NODE_ENV=development

# Puerto de escucha del servidor Express (por defecto 8080)
PORT=8080

# URL base pública de la aplicación para los enlaces de redirección y correos
APP_URL=http://localhost:8080

# Secreto criptográfico largo y aleatorio para firmar las cookies de sesión (express-session)
SESSION_SECRET=cambia_este_secreto_por_una_cadena_aleatoria_muy_larga_y_segura

# ----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL / Opcional para memoria)
# ----------------------------------------------------------------------------
# Si se deja en blanco, el servidor utilizará almacenamiento temporal en memoria.
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/hellfall_db

# Configuración de cifrado SSL para bases de datos gestionadas en la nube. Valores: require o disable.
PGSSL=require

# ----------------------------------------------------------------------------
# CREDENCIALES DEL ADMINISTRADOR INICIAL
# ----------------------------------------------------------------------------
# Se crea o actualiza automáticamente de forma segura al arrancar el servidor.
ADMIN_EMAIL=admin@uclm.es
ADMIN_PASSWORD=contrasena_segura_de_administrador_123

# ----------------------------------------------------------------------------
# RESTRICCIONES Y LÍMITES DE LA APLICACIÓN
# ----------------------------------------------------------------------------
LOG_LEVEL=info
MAX_SCORE_KILLS=100

# Dominios de correo permitidos para el registro de usuarios (separados por comas)
ALLOWED_DOMAINS=uclm.es,alu.uclm.es

# ----------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (Autenticación federada)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# ----------------------------------------------------------------------------
# VERIFICACIÓN Y ACTIVACIÓN DE CUENTAS POR CORREO ELECTRÓNICO
# ----------------------------------------------------------------------------
# Activa la exigencia de confirmar el correo electrónico tras el registro (true/false)
REQUIRE_EMAIL_CONFIRMATION=true

# Configuración SMTP (Ejemplo con servidor SMTP de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu.correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Remitente visible en los correos enviados a los nuevos reclutas
SMTP_FROM="HELLFALL UAC Command <tu.correo@gmail.com>"